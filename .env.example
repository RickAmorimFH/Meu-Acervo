# ACERVO_PUBLIC_MODE=1
# SECRET_KEY=gere-uma-chave-aleatoria-de-pelo-menos-32-caracteres
# MEU_ACERVO_ACCESS_KEY=gere-uma-chave-distinta-de-16-ou-mais-caracteres
# TRUSTED_HOSTS=seudominio.example
