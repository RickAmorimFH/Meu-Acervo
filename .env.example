# Copie para .env somente para documentar valores; o Python NAO le .env automaticamente.
# Para executar localmente, nenhuma variavel e obrigatoria.
APP_HOST=127.0.0.1
APP_PORT=5000
# ACERVO_STORAGE=/caminho/privado/de/arquivos
ACERVO_MAX_TOTAL_BYTES=1500000000
ACERVO_MAX_VIDEO_BYTES=750000000
